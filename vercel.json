{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python scripts/vercel_migrate.py",
  "functions": {
    "api/*.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/poll-leads",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/send-emails",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/process-sequences",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/process-campaigns",
      "schedule": "0 8 * * *"
    }
  ]
}
